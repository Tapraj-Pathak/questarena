generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  FUNDED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
  FINALIZED
}

enum SponsorType {
  GAME_DEVELOPER
  BRAND
}

enum SessionStatus {
  CREATED
  ACTIVE
  SUBMITTED
  EXPIRED
  VERIFIED
  DISPUTED
  FINALIZED
  CANCELLED
}

enum ResultStatus {
  PENDING
  VERIFIED
  FINALIZED
  DISPUTED
  REJECTED
}

enum VerifierStatus {
  ACTIVE
  RETIRED
}

enum VerificationDecision {
  APPROVE
  REJECT
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ClaimStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum WorkflowStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id             String        @id @default(cuid())
  clerkUserId    String        @unique
  displayName    String
  username       String?       @unique
  email          String?
  phoneNumber    String?
  imageUrl       String?
  status         AccountStatus @default(ACTIVE)
  capabilities   String[]      @default([])
  isAdmin        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  playerProfile  PlayerProfile?
  developerProfile GameDeveloperProfile?
  brandProfile   BrandSponsorProfile?
  games          Game[]
  campaigns      Campaign[]    @relation("CampaignOwner")
  participations CampaignParticipant[]
  gameSessions   GameSession[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  claims         RewardClaim[]
  disputes       Dispute[]
  worldIdVerifications WorldIDVerification[]

  @@index([email])
  @@index([status])
}

model PlayerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  bio            String?
  totalScore     BigInt   @default(0)
  gamesPlayed    Int      @default(0)
  bestScore      BigInt   @default(0)
  avgAccuracy    Float    @default(0)
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameDeveloperProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  studioName String
  website    String?
  bio        String?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrandSponsorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  brandName   String
  logoUrl     String?
  website     String?
  description String?
  verified    Boolean  @default(false)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  category       String
  developerName  String
  developerId    String?
  thumbnailUrl   String?
  bannerUrl      String?
  integrationType String // BUILT_IN | EMBEDDED | EXTERNAL_LINK | CUSTOM_ADAPTER
  launchUrl      String?
  playable       Boolean  @default(false)
  rules          Json
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  developer      User?    @relation(fields: [developerId], references: [id], onDelete: SetNull)
  campaigns      Campaign[]
  sessions       GameSession[]
  adapters       GameAdapter[]

  @@index([category])
  @@index([playable])
  @@index([featured])
}

model GameAdapter {
  id           String   @id @default(cuid())
  gameId       String
  adapterName  String
  version      String
  validateSchema Json
  createdAt    DateTime @default(now())
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, adapterName])
}

model Campaign {
  id             String         @id @default(cuid())
  slug           String         @unique
  ownerId        String
  gameId         String
  title          String
  description    String
  sponsorType    SponsorType
  sponsorName    String
  sponsorLogoUrl String?
  status         CampaignStatus @default(DRAFT)
  prizePoolUnits BigInt         @default(0)
  currency       String         @default("USDC")
  startsAt       DateTime
  endsAt         DateTime
  maxParticipants Int?
  rules          Json
  verifyThreshold Int           @default(3)
  requireWorldId Boolean        @default(false)
  contractAddress String?
  cancellationReason String?
  viewCount      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation("CampaignOwner", fields: [ownerId], references: [id])
  game           Game           @relation(fields: [gameId], references: [id])
  participants   CampaignParticipant[]
  sessions       GameSession[]
  placements     CampaignPlacement[]
  transactions   BlockchainTransaction[]
  claims         RewardClaim[]
  workflows      WorkflowExecution[]

  @@index([status, startsAt])
  @@index([ownerId])
  @@index([gameId])
}

model CampaignParticipant {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  joinedAt   DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
}

model CampaignPlacement {
  id         String   @id @default(cuid())
  campaignId String
  placement  String
  creativeUrl String?
  startsAt   DateTime?
  endsAt     DateTime?
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placement])
}

model GameSession {
  id          String        @id @default(cuid())
  campaignId  String
  gameId      String
  playerId    String
  rulesHash   String
  seed        String
  configuration Json
  status      SessionStatus @default(CREATED)
  startsAt    DateTime?
  endsAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  game        Game          @relation(fields: [gameId], references: [id])
  player      User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  evidence    GameEvidence?
  result      GameResult?

  @@index([campaignId, status])
  @@index([playerId, status])
  @@index([expiresAt])
}

model GameEvidence {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  resultHash  String   @unique
  evidenceRef String
  payload     Json
  submittedAt DateTime @default(now())
  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model GameResult {
  id           String       @id @default(cuid())
  sessionId    String       @unique
  score        BigInt
  accuracy     Float?
  completionMs Int?
  moves        Int?
  status       ResultStatus @default(PENDING)
  verifiedCount Int         @default(0)
  requiredCount Int         @default(3)
  resultHash   String?      @unique
  submittedAt  DateTime     @default(now())
  finalizedAt  DateTime?
  session      GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  signatures   VerificationSignature[]
  disputes     Dispute[]
  claim        RewardClaim?

  @@index([status, score])
}

model Verifier {
  id         String         @id @default(cuid())
  name       String         @unique
  publicKey  String         @unique
  status     VerifierStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  signatures VerificationSignature[]
}

model VerificationSignature {
  id          String              @id @default(cuid())
  resultId    String
  verifierId  String
  signature   String
  decision    VerificationDecision
  reason      String
  signedAt    DateTime            @default(now())
  result      GameResult          @relation(fields: [resultId], references: [id], onDelete: Cascade)
  verifier    Verifier            @relation(fields: [verifierId], references: [id])

  @@unique([resultId, verifierId])
  @@index([resultId])
}

model Dispute {
  id          String         @id @default(cuid())
  resultId    String
  raisedBy    String
  reason      String
  status      DisputeStatus  @default(OPEN)
  resolution  String?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  result      GameResult     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [raisedBy], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([status])
}

model RewardClaim {
  id           String       @id @default(cuid())
  resultId     String       @unique
  campaignId   String
  userId       String
  amountUnits  BigInt
  currency     String       @default("USDC")
  txHash       String?
  status       ClaimStatus  @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  result       GameResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([userId])
}

model BlockchainTransaction {
  id        String   @id @default(cuid())
  campaignId String?
  txHash    String   @unique
  chainId   Int?
  kind      String
  status    String
  fromAddress String?
  toAddress  String?
  amountUnits BigInt?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model WorldIDVerification {
  id            String   @id @default(cuid())
  userId        String
  campaignId    String?
  nullifierHash String   @unique
  credentialType String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model WorkflowExecution {
  id          String         @id @default(cuid())
  campaignId  String?
  resultId    String?
  workflowId  String
  runId       String         @unique
  status      WorkflowStatus @default(QUEUED)
  triggerType String
  payload     Json?
  result      Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  campaign    Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([runId])
}
